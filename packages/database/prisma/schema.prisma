generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  passwordHash    String
  fullName       String?
  phone          String?
  location       String?
  rank           String?
  level          Int       @default(0)
  sponsorUsername String?
  memberSince    DateTime  @default(now())
  activeSince    DateTime?
  role           String    @default("USER")
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastSyncAt     DateTime?

  // Relationships
  transactions   Transaction[]
  sessions       Session[]
  wallet         Wallet?
  externalAccounts ExternalAccount[]
  syncRuns      SyncRun[]
  auditLogs     AuditLog[]
  referralLinks ReferralLink[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model ExternalAccount {
  id                     String    @id @default(uuid())
  userId                String
  provider             String    // FXUNIFI, etc.
  externalUsername     String
  encryptedCredentialReference String
  status               String    @default("ACTIVE")
  lastSuccessfulSync   DateTime?
  lastFailedSync       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, provider])
  user                 User      @relation(fields: [userId], references: [id])
}

model Wallet {
  id                   String    @id @default(uuid())
  userId              String    @unique
  capital             Decimal   @default("0")
  totalInvested       Decimal   @default("0")
  totalProfit         Decimal   @default("0")
  totalEarned         Decimal   @default("0")
  totalWithdrawn      Decimal   @default("0")
  availableBalance    Decimal   @default("0")
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id])
}

model ReferralLink {
  id                  String    @id @default(uuid())
  userId             String
  side               String    // left, right
  url                String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id])
  transactions       Transaction[]
}

model Transaction {
  id                  String    @id @default(uuid())
  userId             String
  type               String    // deposit, withdrawal, commission, earnings
  amount             Decimal
  currency           String    @default("USD")
  status             String    @default("PENDING")
  reference          String?
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id])
  referralLinkId    String?
  referralLink      ReferralLink? @relation(fields: [referralLinkId], references: [id])
}

model ReferralMember {
  id                  String    @id @default(uuid())
  ownerUserId         String    // The user who owns this downline
  externalMemberId   String    // ID from FXUNIFI
  username           String
  name               String?
  side               String    // left, right
  parentExternalMemberId String?
  status             String    @default("ACTIVE")
  level              Int
  pv                 Decimal   @default("0")
  syncedAt           DateTime  @default(now())

  @@unique([ownerUserId, externalMemberId])
  @@index([ownerUserId, side])

  // Additional fields for local management
  email              String?
  phone              String?
  location           String?
  rank               String?
}

model SyncRun {
  validationErrors SyncValidationError[]
  id                  String    @id @default(uuid())
  userId             String
  provider           String    // FXUNIFI, etc.
  status             String    @default("PENDING")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  errorMessage       String?
  recordsProcessed    Int       @default(0)
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id                  String    @id @default(uuid())
  userId             String
  action             String
  metadata           Json?
  ipAddress          String?
  userAgent         String?
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id])
}

model SyncValidationError {
  id                 String    @id @default(uuid())
  syncRunId         String
  errorType         String
  errorMessage      String
  recordIdentifier  String?
  severity          String    @default("warning")
  createdAt         DateTime  @default(now())

  syncRun          SyncRun   @relation(fields: [syncRunId], references: [id])
}

// Seed data
model SeedData {
  id     String   @id @default(uuid())
  key    String   @unique
  value  Json
}
