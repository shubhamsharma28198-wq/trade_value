# Database
DATABASE_URL=postgresql://tradevault:tradevault@localhost:5432/tradevault?schema=public
POSTGRES_USER=tradevault
POSTGRES_PASSWORD=tradevault
POSTGRES_DB=tradevault
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=tradevault
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-jwt-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=change-this-encryption-key-32-chars

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
WEB_HOST=127.0.0.1
SEED_ADMIN_PASSWORD=admin1234

# FXUNIFI
FXUNIFI_BASE_URL=https://fxunifi.com
FXUNIFI_USERNAME=
FXUNIFI_PASSWORD=
FXUNIFI_SYNC_INTERVAL_MINUTES=30

# Sync
MOCK_EXTERNAL_PROVIDER=true

# Logging
LOG_LEVEL=debug

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Playwright
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Personal Render/Neon deployment (set these in Render secrets, not GitHub)
# PORTAL_MODE=hosted
# PORTAL_USERNAME=your-private-portal-username
# PORTAL_PASSWORD_HASH=generated-with-node-apps/web/scripts/hash-password.mjs
# DATABASE_URL=your-neon-postgresql-connection-string
# FXUNIFI_USERNAME=your-original-website-username
# FXUNIFI_PASSWORD=your-original-website-password
# APP_URL=https://your-portal.onrender.com
